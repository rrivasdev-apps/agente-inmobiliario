# Proyecto de Supabase del agente (Settings → API). La clave pública (anon o
# publishable) es segura en el navegador: el acceso lo limitan RLS y la membresía.
# Nunca pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del panel: los enlaces de acceso por correo vuelven aquí.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
